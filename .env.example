HOOKRELAY_ENVIRONMENT=development
HOOKRELAY_DATABASE_URL=postgresql+asyncpg://hookrelay:hookrelay@postgres:5432/hookrelay
HOOKRELAY_DATABASE_ECHO=false
HOOKRELAY_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
HOOKRELAY_DEVELOPMENT_API_KEY=hr_dev_local_change_me
HOOKRELAY_SIGNING_ENCRYPTION_KEY=local-development-encryption-key-change-me
HOOKRELAY_ALLOW_PRIVATE_ENDPOINT_URLS=true
HOOKRELAY_MAX_REQUEST_BODY_BYTES=1048576
HOOKRELAY_RATE_LIMIT_REQUESTS_PER_MINUTE=120
HOOKRELAY_WORKER_METRICS_PORT=9000
HOOKRELAY_PUBLISHER_METRICS_PORT=9001
HOOKRELAY_DELIVERY_TIMEOUT_SECONDS=5
HOOKRELAY_RESPONSE_BODY_PREVIEW_BYTES=1024
HOOKRELAY_REDIS_URL=redis://redis:6379/0
HOOKRELAY_REDIS_STREAM_NAME=hookrelay:deliveries
HOOKRELAY_REDIS_CONSUMER_GROUP=hookrelay-workers
HOOKRELAY_WORKER_BLOCK_MS=5000
HOOKRELAY_WORKER_BATCH_SIZE=10
HOOKRELAY_WORKER_CLAIM_IDLE_MS=30000
HOOKRELAY_WORKER_CLAIM_INTERVAL_MS=5000
HOOKRELAY_MAX_DELIVERY_ATTEMPTS=5
HOOKRELAY_RETRY_BASE_DELAY_SECONDS=1
HOOKRELAY_RETRY_MAX_DELAY_SECONDS=60
HOOKRELAY_RETRY_SCHEDULE_NAME=hookrelay:retries
HOOKRELAY_RETRY_SCHEDULER_INTERVAL_MS=500
HOOKRELAY_RETRY_PROMOTION_BATCH_SIZE=100
HOOKRELAY_OUTBOX_POLL_INTERVAL_MS=500
HOOKRELAY_OUTBOX_BATCH_SIZE=100

